# Mend Unified Agent config. API key and user key come from the
# WS_APIKEY / WS_USERKEY environment variables, never this file.
wss.url=https://saas.mend.io/agent
productName=mend-scale-monorepo
# One Mend project per folder passed with -d (see tools/scan.sh).
projectPerFolder=true

checkPolicies=false
forceCheckAllDependencies=true
forceUpdate=true
offline=false

npm.resolveDependencies=true
npm.resolveLockFile=true
npm.includeDevDependencies=false
npm.ignoreScripts=true

python.resolveDependencies=true
# Old pins such as numpy 1.16 do not build on current Python; keep scanning.
python.ignorePipInstallErrors=true
python.runPipenvPreStep=false

maven.resolveDependencies=true
maven.runPreStep=false
maven.ignoredScopes=test provided

includes=**/*.js **/*.py **/*.jar
excludes=**/node_modules/** **/.git/**
